# ==========================================
# FMKAL.com — Environment Variables Guide
# ==========================================

# Port Configuration
PORT=3000
NODE_ENV=production

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://fmkal.com

# Contact Form Configuration
CONTACT_EMAIL=iletisim@fmkal.com

# Required for Coolify production deployment; use a unique, long password
ADMIN_PASSWORD=

# Persistent SQLite database path inside the container
SQLITE_DB_PATH=/app/data/fmkal.db

# (Optional) Webhook for instant notification on Telegram, Discord, or n8n
# Example: https://discord.com/api/webhooks/... or your n8n webhook URL
CONTACT_WEBHOOK_URL=
